# Copy to .env to override. Every value below already has a development default in
# docker-compose.yml, so `docker compose up --build` works without a .env file.
# These are test values only. Never put a real secret here.

APP_ENV=development
PROXY_PORT=8088
MOCK_PAY_PORT=8090
MOCK_GAME_PORT=8091
# mock-game failure behaviour (rates are 0 to 1)
FAIL_RATE=0
TIMEOUT_RATE=0
SUCCESS_BUT_TIMEOUT_RATE=0
LATENCY_MS=0
POSTGRES_PASSWORD=inblack_dev_only
ORDER_TTL_SECONDS=900
PAYMENT_WEBHOOK_SECRET=whsec_test_inblackm_2026
SEED_ADMIN_PASSWORD=Admin-Test-2026
SESSION_SECRET=dev_only_session_secret_change_me
# Payment page address as the customer's browser sees it, e.g. http://192.168.1.45:8090 for a phone
MOCK_PAY_PUBLIC_URL=http://localhost:8090
# Shop address as the customer's browser sees it, used by the payment page's back button
WEB_PUBLIC_URL=http://localhost:8088
